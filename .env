# Server
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Redis (set USE_REDIS=False to use memory cache)
USE_REDIS=True
REDIS_URL=redis://localhost:6379/0

# Cache
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate Limiting
RATELIMIT_DEFAULT=30 per minute
RATELIMIT_DOWNLOAD=10 per minute
RATELIMIT_METADATA=20 per minute

# Download
DOWNLOAD_TIMEOUT=60
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=.mp4,.mkv,.webm,.mov

# Security
SECRET_KEY=xK9mN2pQ5rS7tU8vW3yZ4bC6dE8fG1hJ2kL5nP8qR3tU6wX9
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log